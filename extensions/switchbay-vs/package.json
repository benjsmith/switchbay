{
  "name": "switchbay-vs",
  "displayName": "Switch Bay VS",
  "description": "Knowledge-graph workbench over a curiosity-engine folder. No daemon. Local MLX / llama.cpp / Ollama models for Chat and Agents.",
  "version": "0.2.0",
  "publisher": "switchbay",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjsmith/switchbay.git"
  },
  "homepage": "https://github.com/benjsmith/switchbay",
  "bugs": {
    "url": "https://github.com/benjsmith/switchbay/issues"
  },
  "license": "LicenseRef-FSL-1.1-ALv2",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1115",
    "theme": "dark"
  },
  "keywords": [
    "knowledge-graph",
    "wiki",
    "curiosity-engine",
    "mcp",
    "agents",
    "ollama",
    "mlx"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onView:switchbay.wiki",
    "onView:switchbay.projects"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Switch Bay VS",
      "properties": {
        "switchbay.repoRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the Switch Bay git checkout (Python src + .venv). Empty uses the in-tree parent (F5 only); a Marketplace install must set this."
        },
        "switchbay.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python that can import switchbay (usually <switchbay>/.venv/bin/python)."
        },
        "switchbay.orchestrationPreference": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Auto orchestration effort (0 = Economy, 0.5 = Balanced, 1 = Maximum). Agent count is an outcome of this slider."
        },
        "switchbay.localModels": {
          "type": "array",
          "default": [],
          "description": "Local OpenAI-compatible models (Ollama, llama.cpp, MLX) published to Chat and Agents.",
          "items": {
            "type": "object",
            "properties": {
              "backend": { "type": "string", "enum": ["ollama", "llamacpp", "mlx"] },
              "name": { "type": "string" },
              "model": { "type": "string" },
              "baseUrl": { "type": "string" }
            }
          }
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "switchbay",
          "title": "Switch Bay VS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "switchbay": [
        {
          "id": "switchbay.wiki",
          "name": "Wiki"
        },
        {
          "id": "switchbay.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "switchbay.wiki",
        "contents": "Open a curiosity-engine folder (`wiki/` + `vault/`).\n[Open Folder](command:switchbay.openWorkspace)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "switchbay.wiki",
        "contents": "This folder has no `wiki/` directory. Open a curiosity-engine workspace, or add `wiki/` here.\n[Open Folder](command:switchbay.openWorkspace)",
        "when": "workspaceFolderCount != 0 && !switchbay.hasWiki"
      }
    ],
    "commands": [
      {
        "command": "switchbay.openGraph",
        "title": "Switch Bay VS: Open Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "switchbay.openPreview",
        "title": "Switch Bay VS: Open Wiki Preview"
      },
      {
        "command": "switchbay.openAgents",
        "title": "Switch Bay VS: Open Agent Dashboard",
        "icon": "$(organization)"
      },
      {
        "command": "switchbay.fireThrusters",
        "title": "Switch Bay VS: Fire Thrusters"
      },
      {
        "command": "switchbay.rebuildViewer",
        "title": "Switch Bay VS: Rebuild Wiki Viewer"
      },
      {
        "command": "switchbay.openPage",
        "title": "Switch Bay VS: Open Wiki Page"
      },
      {
        "command": "switchbay.openWorkspace",
        "title": "Switch Bay VS: Open Workspace Folder"
      },
      {
        "command": "switchbay.refreshTrees",
        "title": "Switch Bay VS: Refresh Wiki & Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "switchbay.curate",
        "title": "Switch Bay VS: Curate (Agents session)"
      },
      {
        "command": "switchbay.openAgentsWindow",
        "title": "Switch Bay VS: Open VS Code Agents Window"
      },
      {
        "command": "switchbay.localModels",
        "title": "Switch Bay VS: Local models (Ollama, llama.cpp, MLX)…"
      },
      {
        "command": "switchbay.configurePython",
        "title": "Switch Bay VS: Configure Python…"
      },
      {
        "command": "switchbay.setEffort",
        "title": "Switch Bay VS: Set orchestration effort…"
      },
      {
        "command": "switchbay.addSchedule",
        "title": "Switch Bay VS: Schedule a named agent…"
      },
      {
        "command": "switchbay.runNamedAgent",
        "title": "Switch Bay VS: Run named agent…"
      },
      {
        "command": "switchbay.checkUpdate",
        "title": "Switch Bay VS: Update extension…"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "switchbay.openPreview",
          "when": "resourceExtname == .md && resourcePath =~ /wiki/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "switchbay.openGraph",
          "when": "view == switchbay.wiki",
          "group": "navigation@1"
        },
        {
          "command": "switchbay.openAgents",
          "when": "view == switchbay.wiki",
          "group": "navigation@2"
        },
        {
          "command": "switchbay.refreshTrees",
          "when": "view == switchbay.wiki || view == switchbay.projects",
          "group": "navigation@3"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "switchbay.participant",
        "fullName": "Switch Bay VS",
        "name": "switchbay",
        "description": "Knowledge-graph workbench over this folder (CE, wiki tools, Auto).",
        "isSticky": true,
        "commands": [
          {
            "name": "thrusters",
            "description": "Arm Mars Hopper"
          },
          {
            "name": "curate",
            "description": "Curate the wiki (Auto orchestration)"
          },
          {
            "name": "plot",
            "description": "Author Vega-Lite plots as wiki figures"
          },
          {
            "name": "deck",
            "description": "Author an HTML slideshow"
          },
          {
            "name": "sketch",
            "description": "Author a sketch (companion extension)"
          }
        ]
      }
    ],
    "chatAgents": [
      { "path": "./agents/auto.agent.md" },
      { "path": "./agents/curator.agent.md" },
      { "path": "./agents/investigator.agent.md" },
      { "path": "./agents/reviewer.agent.md" }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "switchbay.mcp",
        "label": "Switch Bay VS"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "switchbay-local",
        "displayName": "Switch Bay VS Local"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "echo 'From the Switch Bay repo root run: make vsix' && exit 1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.134.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.5.4"
  }
}
