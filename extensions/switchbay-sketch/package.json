{
  "name": "switchbay-sketch",
  "displayName": "Switch Bay Sketch",
  "description": "Excalidraw/drawio sketches for Switch Bay workspaces. Companion to the Switch Bay plugin, not bundled with it.",
  "version": "0.0.0",
  "publisher": "switchbay",
  "license": "LicenseRef-FSL-1.1-ALv2",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "switchbay.sketch",
        "displayName": "Switch Bay Sketch",
        "selector": [
          { "filenamePattern": ".workbench/sketches/*.json" }
        ],
        "priority": "option"
      }
    ]
  }
}
