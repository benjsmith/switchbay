# ── python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
dist/
build/

# ── node / frontend ──
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/
frontend/.vite/
*.tsbuildinfo

# ── editor / os ──
.DS_Store
.idea/
.vscode/

# ── workspace runtime (when this repo is opened as its own workspace) ──
.workbench/

# ── agent-skill installs (npx skills add) — must be user-global, never repo-local ──
.agents/
.claude/
skills-lock.json

# ── private project docs — kept local, never published (start fresh here) ──
charter.md
work-plan.md
log.md
docs/enterprise-windows-design.md
docs/*-design.md

# ── machine-level admin policy drop-in (never commit a live copy) ──
/admin.json

# ── regenerable / local-only ──
docs/*.pdf

# ── bench run output (never ship) ──
bench/results/
bench/cache/
bench/repro-out/
bench/**/__pycache__/

# ── sample workspace runtime (regenerable) ──
samples/**/vault.db
samples/**/.curator/
samples/**/wiki-history.bundle
samples/**/vault/*.extracted.md
samples/**/vault/raw/
samples/**/uv.toml
