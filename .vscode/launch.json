{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Switch Bay VS",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/switchbay-vs"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/switchbay-vs/out/**/*.js"
      ],
      "preLaunchTask": "switchbay-compile"
    }
  ]
}
